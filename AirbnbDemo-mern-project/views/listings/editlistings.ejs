<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Airbnb Demo</title>
</head>
<body>
  <h1>Edit Listing</h1>

  <form method="POST" action="/listings/<%=listing._id%>?_method=put">

  <h2>Title: <input type="text" name="listing[title]" value="<%=listing.title%>" ><br/><br/></h2>


  <div>
  <img src=<%=listing.image%> height="200px"><input type="text" name="listing[image]" value="<%=listing.image%>" ><br/><br/></div>

  <p>Description:</p><textarea type="text"  name="listing[description]" ><%=listing.description%></textarea>

  <p>price:</p>
<input type="number" name="listing[price]" value="<%= listing.price%>">


  <p>location:</p><input type="text" name="listing[location]" value="<%=listing.location%>">
  <p>country:</p><input type="text" name="listing[country]" value="<%=listing.country%>" >

  <button>Edit</button>
  </form>
</body>
</html>