
<%layout("/layouts/boilerplate")%>
<body>
<h1>Airbnb Home page</h1>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
<%for(let listing of alllistings){%>
  <a href="/listings/<%=listing.id%>" class="listing-link">
<div class="card " >
  <img src="<%=listing.image%>" class="card-img-top" altlisting-image style="height: 20rem" >
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text"><b><%=listing.title%></b><br/>₹<%=listing.price.toLocaleString("en-IN")%>/night</p>
  </div>
</div>
</a>
<%}%>
</div>



