
<%layout("/layouts/boilerplate")%>

<h1>All Listings</h1>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
<%for(let listing of alllistings){%>
  <a href="/listings/<%=listing.id%>" class="listing-link">
<div class="card " >
    <%# Shimmer added by Copilot: remove it after the listing image loads. %>
  <img src="<%=listing.image%>" class="card-img-top shimmer" alt="listing-image" style="height: 20rem" onload="this.classList.remove('shimmer')" >
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text"><b><%=listing.title%></b><br/>₹<%=listing.price.toLocaleString("en-IN")%>/night</p>
  </div>
</div>
</a>
<%}%>
</div>



