<%=layout("layouts/boilerplate")%>

<div class="row">
  <div class="col-8 offset-3">
    <h3>Listing Details :</h3>
  </div>

  <div class="card col-6 offset-3 show-card">
    <%# Shimmer added by Copilot: remove it after the listing image loads. %>
    <img
      src="<%=listing.image%>"
      class="card-img-top show-img shimmer"
      alt="listing-image"
      onload="this.classList.remove('shimmer')"
    />
    <div class="card-body">
      <p class="card-text">
        <b> <%=listing.title%></b><br />
        <%=listing.description%><br />
        ₹<%=listing.price.toLocaleString("en-IN")%><br />
        <%=listing.location%><br />
        <%=listing.country%><br />
      </p>
    </div>
  </div>
  <div class="btns">
    <a href="/listings/<%=listing._id%>/edit" class="btn col-1 offset-3 add-btn"
      >Edit
    </a>

    <form method="post" action="/listings/<%=listing._id%>?_method=delete">
      <button class="btn btn-dark offset-4">Delete</button>
    </form>
  </div>
</div>
