<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirbnbDemo</title>
  </head>
  <body>
    <h1>Listing Details:</h1>
    <ul>
      <li><%=listing.title%></li>
      <li><%=listing.description%></li>
      <li>₹<%=listing.price.toLocaleString("en-IN")%></li>
      <li><%=listing.location%></li>
      <li><%=listing.country%></li>
    </ul>
    <a href="/listings/<%=listing._id%>/edit">Edit this Listings </a>
    <form method="post" action="/listings/<%=listing._id%>?_method=delete"><br/>
      <button>Delete</button>
    </form>
  </body>
</html>
