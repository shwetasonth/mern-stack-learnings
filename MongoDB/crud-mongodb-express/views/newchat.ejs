<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Write your chat here</title>
  </head>
  <body>
    <h3>Write your chat here</h3>
    <form method="post" action="/chats">
      <input
        type="text"
        placeholder="who are you"
        name="from"
      /><br /><br />
      <textarea placeholder="Write your message here..." name="msg"></textarea
      ><br /><br />
      <input type="text" placeholder="add receiver" name="to" /><br /><br />
      <button>Create chat</button>
    </form>
  </body>
</html>
