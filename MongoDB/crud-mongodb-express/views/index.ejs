<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mini whatsup</title>
  <link rel="stylesheet" href="./style.css"
</head>
<body>
  <h3>All Chats!</h3>
  <form method="get" action="/chats/new">
    <button>New chat</button>
  </form>
  <%for(let chat of chats){%>
    <div class="chats">
      <p>  From :<i> <%=chat.from%></i></p>
      <div class="msg">

        <p>  <%=chat.msg%></p>
      <form method="GET" action="/chats/<%=chat._id%>/edit">
        <button>Edit</button>
      </form>
<br/>
      <form method="POST" action="/chats/<%=chat._id%>?_method=delete">
        <button>Delete</button>
      </form>
      </div>
      <p>  Received by : <i><%=chat.to%></i></p>
      <hr/>
      <%=chat.created_At.toString().split(" ")[4]%><br/><br/>
      <%=chat.created_At.toString().split(" ").slice(0,4).join("-")%>
    </div>
<br/><br/>
    <%}%>

</body>
</html>